# Maintainer: Your Name <you@example.com>
pkgname=printo
pkgver=0.2.0
pkgrel=1
pkgdesc='Small, fast GTK4 GUI for CUPS: print files and manage the queue'
arch=('any')
url='https://github.com/Campus2454/printo'
license=('MIT')
depends=('python' 'python-gobject' 'python-pycups' 'gtk4' 'libadwaita' 'cups')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Keep SKIP in this repo copy. A tag's tarball contains this very file, so a
# checksum written here would change the tarball and never match.
# The real checksum goes in the PKGBUILD of the AUR repo: run `updpkgsums` there.
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  python -m unittest discover -s tests
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm644 data/io.github.campus2454.printo.desktop \
    "$pkgdir/usr/share/applications/io.github.campus2454.printo.desktop"
  install -Dm644 data/icons/hicolor/scalable/apps/io.github.campus2454.printo.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.campus2454.printo.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
